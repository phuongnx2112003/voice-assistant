# OpenAI-compatible LLM connection used by test_tts_sherpa-onxx.py
OPENAI_API_KEY=your_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini

# Local-only speaker embedding store. The SQLite file is ignored by Git.
SPEAKER_DATABASE=.data/speaker_embeddings.sqlite3
SPEAKER_NAME=owner
SPEAKER_THRESHOLD=0.60
SPEAKER_ENROLL_SAMPLES=5
SPEAKER_ENROLL_SECONDS=5
SPEAKER_VERIFY_SECONDS=4
SPEAKER_MIN_SAMPLE_SECONDS=1.5
SPEAKER_ENROLL_MIN_SIMILARITY=0.50

# Voice pipeline tuning
VAD_THRESHOLD=0.50
WAKE_THRESHOLD=0.50
STT_THREADS=2
INITIAL_SPEECH_TIMEOUT_SECONDS=4
SILENCE_SECONDS=1
MAX_UTTERANCE_SECONDS=15
